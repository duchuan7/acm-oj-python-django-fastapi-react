# Run scripts/setup.ps1 or scripts/setup.sh to generate .env; never commit real secrets.
DB_PASSWORD=GENERATE_ME
MYSQL_ROOT_PASSWORD=GENERATE_ME
RABBIT_PASSWORD=GENERATE_ME
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_ME
SEED_DEMO=true

