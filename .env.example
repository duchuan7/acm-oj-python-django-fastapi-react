DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=acmoj
POSTGRES_USER=acmoj
POSTGRES_PASSWORD=acmoj_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
BACKEND_BASE_URL=http://backend:8000
JUDGE_INTERNAL_TOKEN=change-me-judge-token
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=change-me-local-admin-password
DEMO_ADMIN_EMAIL=admin@example.com

SUBMISSION_CODE_MAX_BYTES=65536
SUBMISSION_RATE_LIMIT_SECONDS=1
SUBMISSION_RATE_LIMIT_COUNT=5
SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60

# Local development prints registration codes in backend logs.
# For production, switch to django.core.mail.backends.smtp.EmailBackend and configure SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@duilio-oj.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
REGISTRATION_CODE_TTL_SECONDS=600
REGISTRATION_CODE_COOLDOWN_SECONDS=60
REGISTRATION_CODE_IP_LIMIT=10
REGISTRATION_CODE_IP_WINDOW_SECONDS=3600
REGISTRATION_CODE_VERIFY_LIMIT=10

JUDGE_WORKDIR=/tmp/acmoj-run
JUDGE_DOCKER_NETWORK=none
JUDGE_RUNS_VOLUME=acmoj_judge_runs
TESTCASE_VOLUME=acmoj_testcase_data
